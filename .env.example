# LLM via API compatível com OpenAI. Padrão: Gemini (camada gratuita).
# Chave: https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Outros provedores (basta trocar as três variáveis acima):
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1                 LLM_MODEL=<modelo>
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=<modelo local>
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1             LLM_MODEL=<modelo>

EMBEDDING_MODEL=intfloat/multilingual-e5-small
